# --- TMDB ---
# https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=

# --- Google Drive (nativní Sign-In v mobilu) ---
# 1) Zapni Google Drive API
# 2) OAuth consent screen + scope:
#    https://www.googleapis.com/auth/drive.file
# 3) Vytvoř OAuth Client ID typu Web application → sem:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 4) Vytvoř OAuth Client ID typu Android:
#    package: com.watchlist.app
#    SHA-1 z debug keystore (viz README)
# Android Client ID se do .env nedává.
